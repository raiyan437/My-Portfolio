---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ProfileIntro from "../components/ProfileIntro.astro";
import ExpertiseList from "../components/ExpertiseList.astro";
import CareerSections from "../components/CareerSections.astro";
import { selectedProjects } from "../data/projects";
---
<BaseLayout home>
  <Hero />

  <section class="selected-work" id="work" aria-labelledby="work-title" tabindex="-1">
    <SectionHeading id="work-title" title="Selected work" backdrop="Portfolio" centered />
    <ProjectGrid projects={selectedProjects} eagerCount={1} stack />
  </section>

  <section class="section about-section" id="about" aria-labelledby="about-title">
    <SectionHeading id="about-title" title="About me" />
    <ProfileIntro showAboutLink />
  </section>

  <section class="section expertise-section" id="expertise" aria-labelledby="expertise-title" tabindex="-1">
    <SectionHeading id="expertise-title" title="Technical expertise" backdrop="Expertise" />
    <ExpertiseList />
  </section>

  <CareerSections home />
</BaseLayout>
