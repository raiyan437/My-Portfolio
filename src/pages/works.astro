---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { orderedProjects } from "../data/projects";
---
<BaseLayout title="Work · Raiyan Uddin" description="Product QA, Playwright automation, and API testing case studies by Raiyan Uddin.">
  <section class="section panel work-section work-section--index" aria-labelledby="works-title">
    <SectionHeading id="works-title" title="All work" backdrop="Portfolio" level="h1" centered />
    <ProjectGrid projects={orderedProjects} eagerCount={2} />
  </section>
</BaseLayout>
