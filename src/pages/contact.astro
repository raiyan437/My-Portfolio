---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE_CONFIG } from "../config/site";
import { getBaseUrl } from "../utils/base";

const base = getBaseUrl();
const acceptsPosts = import.meta.env.PROD && process.env.NETLIFY === "true";
const ComposePanel = acceptsPosts ? "div" : "details";
const phoneHref = "tel:" + SITE_CONFIG.phone.replace(/[^+\d]/g, "");
---
<BaseLayout title="Contact · Raiyan Uddin" description="Contact Raiyan Uddin about software testing, automation, and QA projects." showInvitation={false}>
  <section class="panel section subpage-section contact-page" aria-labelledby="contact-title">
    <SectionHeading id="contact-title" title="Let’s talk testing." backdrop="Contact" level="h1" />
    <div class="contact-grid">
      <div class="contact-details" data-reveal>
        <p>Tell me what you’re building and where you’d like help with testing.</p>
        <div class="contact-email-actions">
          <a class="button button--dark" href={SITE_CONFIG.socials.email} target="_blank" rel="noopener noreferrer">Email me</a>
          <button class="button button--light" type="button" data-copy-email={SITE_CONFIG.email} hidden>Copy email address</button>
        </div>
        <p class="contact-copy-status" role="status" data-copy-status></p>
        <address>
          <span>{SITE_CONFIG.email}</span>
          <a href={phoneHref}>{SITE_CONFIG.phone}</a>
          <span>{SITE_CONFIG.location}</span>
        </address>
      </div>
      <ComposePanel class="contact-compose" data-contact-draft={!acceptsPosts || undefined} hidden={!acceptsPosts} data-reveal>
        {!acceptsPosts && <summary><span class="disclosure-mark" aria-hidden="true"></span>Write an email draft</summary>}
        <form
          class="contact-form"
          name="contact"
          method={acceptsPosts ? "POST" : undefined}
          action={acceptsPosts ? base + "contact/" : undefined}
          data-netlify={acceptsPosts ? "true" : undefined}
          netlify-honeypot={acceptsPosts ? "bot-field" : undefined}
          data-contact-form
          data-compose-url={acceptsPosts ? undefined : SITE_CONFIG.socials.email}
        >
          {acceptsPosts && (
            <>
              <input type="hidden" name="form-name" value="contact" />
              <p hidden><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            </>
          )}
          <div class="field">
            <label for="email">Your email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" maxlength="160" required />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <button class="button button--dark" type="submit">{acceptsPosts ? "Send message" : "Open email draft"}</button>
          <p class="form-status" role="status" data-contact-status>{!acceptsPosts && "This opens a draft in Gmail."}</p>
        </form>
      </ComposePanel>
      <div class="contact-profiles" data-reveal>
        <SocialLinks showEmail={false} />
      </div>
    </div>
  </section>
</BaseLayout>
