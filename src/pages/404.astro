---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBaseUrl } from "../utils/base";

const base = getBaseUrl();
---
<BaseLayout title="Page not found · Raiyan Uddin" noindex showInvitation={false}>
  <section class="panel section subpage-section missing-page">
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <a class="button button--dark" href={base}>Back to home</a>
  </section>
</BaseLayout>
