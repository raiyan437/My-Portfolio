---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryBar from "../components/GalleryBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { certificates, certificateTopics } from "../data/certificates";
import { getBaseUrl } from "../utils/base";

const base = getBaseUrl();
const groups = [
  { id: "featured-credentials", title: "Featured credentials", entries: certificates.filter(({ featured }) => featured), loading: "eager" },
  { id: "more-certifications", title: "More certifications", entries: certificates.filter(({ featured }) => !featured), loading: "lazy" },
] as const;
---
<BaseLayout title="Certifications · Raiyan Uddin" description="Certificates in artificial intelligence, information security, design, and community work.">
  <section class="panel section subpage-section" aria-labelledby="certificate-title" data-certificates>
    <SectionHeading id="certificate-title" title="Certifications" backdrop="Learning" level="h1" centered />
    <GalleryBar labels={certificateTopics} noun="certificate" count={certificates.length} class="certificate-filters" />
    {groups.map(({ id, title: groupTitle, entries, loading }) => (
      <section class="certificate-group" aria-labelledby={id} data-certificate-group>
        <h2 id={id} data-reveal>{groupTitle}</h2>
        <div class="certificate-grid">
          {entries.map(({ title, issuer, category, topic, year, file = title }) => (
            <article class="certificate-card" data-filter-group={topic} data-reveal>
              <div class="certificate-media" data-depth>
                <img src={base + "images/certificates/" + encodeURIComponent(file) + ".webp"} alt="" loading={loading} decoding="async" />
              </div>
              <div class="certificate-copy">
                <p class="eyebrow">{category} · {year}</p>
                <h3>{title}</h3>
                <p class="certificate-issuer">{issuer}</p>
                <div class="certificate-actions">
                  <button class="button button--light" type="button" aria-label={"Preview " + title} aria-haspopup="dialog" data-certificate-preview hidden>Preview</button>
                  <a
                    class="certificate-open"
                    href={base + "assets/Certificates/" + encodeURIComponent(file) + ".pdf"}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={"Open PDF for " + title}
                    data-certificate-pdf
                  >Open PDF</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
    <dialog class="certificate-dialog" aria-labelledby="certificate-preview-title" data-certificate-dialog>
      <header class="certificate-dialog-header">
        <div>
          <h2 id="certificate-preview-title"></h2>
          <p data-certificate-preview-issuer></p>
        </div>
        <form method="dialog">
          <button class="button button--light" type="submit" autofocus>Close</button>
        </form>
      </header>
      <img alt="" data-certificate-preview-image />
      <a class="button button--dark" target="_blank" rel="noopener noreferrer" data-certificate-preview-pdf>Open PDF</a>
    </dialog>
  </section>
</BaseLayout>
