---
import "@fontsource-variable/manrope";
import "../styles/portfolio.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG } from "../config/site";
import { getBaseUrl } from "../utils/base";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
  noindex?: boolean;
  showInvitation?: boolean;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.ogImage,
  home = false,
  noindex = false,
  showInvitation = true,
} = Astro.props;

const base = getBaseUrl();
const origin = Astro.site ?? new URL(SITE_CONFIG.url);
const canonical = new URL(Astro.url.pathname, origin);
const socialImage = new URL(base + image, origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e4e3df" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.name} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={base + "sitemap-index.xml"} />
    <link rel="icon" type="image/png" href={base + SITE_CONFIG.logo} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      window.addEventListener("pagereveal", (event) => {
        document.documentElement.toggleAttribute("data-native-transition", Boolean(event.viewTransition));
      });
    </script>
  </head>
  <body id="top" tabindex={home ? "-1" : undefined}>
    <div class="custom-cursor" aria-hidden="true">
      <span class="custom-cursor-ring"></span>
      <span class="custom-cursor-dot"></span>
    </div>
    <div class="page-progress" data-page-progress aria-hidden="true" hidden></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={["site-shell", { "site-shell--home": home }]}>
      <Header />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer showInvitation={showInvitation} />
    </div>
    {home && (
      <a class="button button--dark home-back-to-top" href="#top" aria-label="Back to top of homepage" data-home-back-to-top hidden></a>
    )}
    <script>
      import "../scripts/portfolio";
    </script>
  </body>
</html>
