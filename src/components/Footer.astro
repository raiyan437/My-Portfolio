---
import { SITE_CONFIG } from "../config/site";
import { getBaseUrl } from "../utils/base";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  showInvitation?: boolean;
}

const { showInvitation = true } = Astro.props;
const base = getBaseUrl();
---
<footer class="site-footer" id="contact">
  {showInvitation && (
    <section class="footer-invitation panel" aria-labelledby="footer-heading">
      <p class="eyebrow" data-reveal>/ Contact</p>
      <h2 id="footer-heading" data-reveal>Let’s talk testing.</h2>
      <p data-reveal>Have a project in mind? Tell me what you’re building.</p>
      <a class="button button--dark" href={base + "contact/"} data-reveal>Contact me</a>
      <SocialLinks variant="footer" />
    </section>
  )}
  <div class="footer-bar" data-reveal>
    <a class="footer-brand" href={base}>© {new Date().getFullYear()} {SITE_CONFIG.name}</a>
    <nav aria-label="Footer">
      <a href={base + "about/"}>About</a>
      <a href={base + "works/"}>Work</a>
      <a href={base + "skills/"}>Skills</a>
      <a href={base + "certifications/"}>Certifications</a>
      <a href={base + "contact/"}>Contact</a>
    </nav>
    <a class="back-to-top" href="#top">Back to top</a>
  </div>
</footer>
