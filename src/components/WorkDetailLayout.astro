---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "./ProjectGrid.astro";
import ProjectCoverImage from "./ProjectCoverImage.astro";
import SectionHeading from "./SectionHeading.astro";
import { projects, publicProjects, type Project } from "../data/projects";
import { getBaseUrl } from "../utils/base";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { caseStudy } = project;
const base = getBaseUrl();
const next = projects.find(({ slug }) => slug === project.next);
const otherWork = publicProjects.filter(({ slug }) => slug !== project.slug && slug !== project.next);
const related = [
  ...otherWork.filter(({ group }) => group === project.group),
  ...otherWork.filter(({ group }) => group !== project.group),
].slice(0, 2);
---
<BaseLayout
  title={project.title + " · Raiyan Uddin"}
  description={project.summary}
  image={project.cover}
  noindex={project.group === "unlisted"}
>
  <article class="panel section subpage-section case-study">
    <a class="button button--light case-back" href={base + "works/"} data-work-return={base + "#work"}>
      Back to projects
    </a>
    <header class="case-header" data-reveal>
      <div>
        <ul class="tags" aria-label="Tools and practices">
          {project.tools.map((tool) => <li class="pill">{tool}</li>)}
        </ul>
        <h1>{project.title}</h1>
        <p>{project.summary}</p>
      </div>
      <dl class="case-facts">
        {project.client && <div><dt>Project</dt><dd>{project.client}</dd></div>}
        <div><dt>Year</dt><dd>{project.year}</dd></div>
        <div><dt>Work</dt><dd>{project.services}</dd></div>
      </dl>
    </header>
    <div class="case-contribution" data-reveal>
      <section class="case-highlight" aria-labelledby="case-contribution-heading">
        <h2 id="case-contribution-heading">My contribution</h2>
        <p>{project.overview}</p>
      </section>
      <section class="case-highlight" aria-labelledby="case-deliverable-heading">
        <h2 id="case-deliverable-heading">What the work delivered</h2>
        <p>{caseStudy.deliverable}</p>
      </section>
    </div>
    <figure class="case-image" data-reveal>
      <ProjectCoverImage
        path={project.cover}
        sizes="(max-width: 48rem) 84vw, (max-width: 65rem) 80vw, min(74vw, 72rem)"
        alt={project.coverAlt}
        loading="eager"
        priority
      />
    </figure>
    <div class="case-content">
      <section data-reveal>
        <h2>{caseStudy.checks ? "The challenge" : "Context"}</h2>
        <p>{project.context}</p>
        {project.details && <p>{project.details}</p>}
      </section>
      <section data-reveal>
        <h2>Testing coverage</h2>
        <p>{project.coverage}</p>
        {caseStudy.checks && (
          <dl class="case-checks" aria-label="Representative checks">
            {caseStudy.checks.map(({ area, verification }) => (
              <div>
                <dt>{area}</dt>
                <dd>{verification}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    </div>
    <div class="case-actions" data-reveal>
      <a class="button button--light case-contact" href={base + "contact/"}>Contact me</a>
      {next && (
        <a class="case-next" href={base + "works/" + next.slug + "/"} data-work-project>
          <small>Next project</small>{next.title}
        </a>
      )}
    </div>
    <section class="related-work" aria-labelledby="related-work-heading">
      <SectionHeading id="related-work-heading" title="More work" centered />
      <ProjectGrid projects={related} filterable={false} />
    </section>
  </article>
</BaseLayout>
