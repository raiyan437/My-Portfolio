---
import { SITE_CONFIG } from "../config/site";
import { socialIcons } from "../data/social-icons";
import { getBaseUrl } from "../utils/base";

interface Props {
  variant?: "hero" | "footer" | "all";
  showEmail?: boolean;
}

const { variant = "all", showEmail = true } = Astro.props;
const profiles = [
  { name: "LinkedIn", url: SITE_CONFIG.socials.linkedin, icon: "linkedin" },
  { name: "GitHub", url: SITE_CONFIG.socials.github, icon: "github" },
  { name: "Email", url: SITE_CONFIG.socials.email, icon: "email" },
  { name: "WhatsApp", url: SITE_CONFIG.socials.whatsapp, icon: "whatsapp" },
  { name: "Facebook", url: SITE_CONFIG.socials.facebook, icon: "facebook" },
  { name: "Instagram", url: SITE_CONFIG.socials.instagram, icon: "instagram" },
] as const;

const links = (variant === "all" ? profiles : profiles.slice(0, 4)).filter(({ icon }) => showEmail || icon !== "email");
const base = getBaseUrl();
---
<ul class:list={["social-links", "social-links--" + variant]} aria-label="Contact and profiles">
  {variant === "footer" && (
    <li data-reveal>
      <a class="pill footer-home" href={base} aria-label={SITE_CONFIG.name + " home"}>
        <img class="brand-logo" src={base + SITE_CONFIG.logo} alt="" width="242" height="296" loading="lazy" decoding="async" />
        {SITE_CONFIG.name}
      </a>
    </li>
  )}
  {links.map(({ name, url, icon }) => (
    <li data-reveal={variant === "footer" || undefined}>
      <a class="pill" href={url} target="_blank" rel="noopener noreferrer">
        <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d={socialIcons[icon]} fill-rule={icon === "github" ? "evenodd" : undefined} />
        </svg>
        {name}
      </a>
    </li>
  ))}
</ul>
