---
import { SITE_CONFIG } from "../config/site";
import { getBaseUrl } from "../utils/base";

const base = getBaseUrl();
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "");
const nav = [
  { name: "Projects", route: "works" },
  { name: "Expertise", route: "skills" },
  { name: "Experience", route: "experience" },
  { name: "Certifications", route: "certifications" },
];
const onRoute = (route: string) => path === route || path.startsWith(route + "/");
const current = (route: string) => onRoute(route) ? (path === route ? "page" : "true") : undefined;
const contactCurrent = onRoute("contact") ? "page" : undefined;
---
<header class="topbar">
  <a class="brand" href={base} aria-label={SITE_CONFIG.name + " home"}>
    <span class="brand-badge">
      <img class="brand-logo" src={base + SITE_CONFIG.logo} alt="" width="242" height="296" />
    </span>
  </a>
  <nav class="desktop-nav" aria-label="Main">
    {nav.map(({ name, route }) => (
      <a href={base + route + "/"} aria-current={current(route)}>{name}</a>
    ))}
  </nav>
  <a class="button button--dark topbar-contact" href={base + "contact/"} aria-current={contactCurrent}>Contact</a>

  <details class="mobile-nav">
    <summary class="pill"><span>Menu</span><span class="menu-mark" aria-hidden="true"></span></summary>
    <nav aria-label="Main">
      {nav.map(({ name, route }) => (
        <a href={base + route + "/"} aria-current={current(route)}>{name}</a>
      ))}
      <a href={base + "contact/"} aria-current={contactCurrent}>Contact</a>
      <a href={base + SITE_CONFIG.resume}>Résumé</a>
    </nav>
  </details>
</header>
